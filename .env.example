# Copy to .env.local (gitignored) and fill from Firebase console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required). Set ONE of these site keys:
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
VITE_RECAPTCHA_V3_SITE_KEY=

# Local dev only: App Check debug token (register it in console > App Check > Manage debug tokens).
# Used only by `npm run dev`; never baked into production builds. Never commit a real value.
VITE_APPCHECK_DEBUG_TOKEN=

# Optional: cloud model for analysis (default gemini-3.5-flash-lite, the SDK's hybrid default).
VITE_CLOUD_MODEL=
